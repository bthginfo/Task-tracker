# Copy to .env. Never commit .env or real credentials.
PORT=3000
APP_URL=http://localhost:3000
DATABASE_PATH=./data/fokus.sqlite
DATABASE_URL=
TZ=Europe/Paris
APP_TIMEZONE=Europe/Paris

# Required for Google OAuth; stable 32+ character random secret.
APP_SECRET=
# Required in production (16+ characters); optional on localhost.
APP_PASSWORD=

# OAuth client type: Web application. Enable Google Calendar API.
# Authorized redirect URI: APP_URL/api/calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional higher quality dictation. Without it, browser dictation is used.
# Audio is sent to OpenAI only after explicit consent in the app.
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Set to 1 only behind a trusted single reverse proxy.
TRUST_PROXY=0
